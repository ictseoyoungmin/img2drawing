{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://img2drawing.local/schemas/modular_grammar_card.schema.json",
  "title": "Modular grammar card v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "card_id", "stage", "polarity", "scope", "transfer_mapping", "source_audit_status"],
  "properties": {
    "schema": {"const": "img2drawing.modular_grammar_card.v1"},
    "card_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "polarity": {"enum": ["positive", "negative"]},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "transfer_mapping": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_audit_status": {"enum": ["pass", "fail", "unproven", "not_audited"]}
  }
}
