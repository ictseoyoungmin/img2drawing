{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://img2drawing.local/schemas/observation_lock.schema.json",
  "title": "img2drawing Frozen Observation Lock v1",
  "type": "object",
  "required": [
    "schema",
    "observation",
    "subject_reference_sha256",
    "observation_id",
    "locked_at_cursor",
    "locked_at_stage",
    "observation_digest",
    "replacement_of"
  ],
  "properties": {
    "schema": {"const": "img2drawing.observation_lock.v1"},
    "observation": {"$ref": "observation.schema.json"},
    "subject_reference_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observation_id": {"type": "string", "minLength": 1},
    "locked_at_cursor": {"type": "integer", "minimum": 0},
    "locked_at_stage": {"type": "string", "minLength": 1},
    "observation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replacement_of": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
