{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://img2drawing.local/schemas/prop_topology.schema.json",
  "title": "Generic prop topology evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "prop_id", "major_axis_start", "major_axis_end", "width_change_points", "terminal_masses", "body_overlap_points", "visible_interruptions", "occlusion_order", "source_surface", "observation_id", "source_artifact_sha256", "observation_lock_digest", "source_state_sha256"],
  "properties": {
    "schema": {"const": "img2drawing.prop_topology.v1"},
    "prop_id": {"type": "string", "minLength": 1},
    "major_axis_start": {"$ref": "#/$defs/point"},
    "major_axis_end": {"$ref": "#/$defs/point"},
    "width_change_points": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/widthPoint"}},
    "terminal_masses": {"type": "array", "items": {"$ref": "#/$defs/terminal"}},
    "body_overlap_points": {"type": "array", "items": {"$ref": "#/$defs/overlap"}},
    "visible_interruptions": {"type": "array", "items": {"type": "string"}},
    "occlusion_order": {"type": "array", "items": {"type": "string"}},
    "source_surface": {"enum": ["reference", "drawing"]},
    "observation_id": {"type": "string", "minLength": 1},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "observation_lock_digest": {"$ref": "#/$defs/sha256"},
    "source_state_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}],
      "minItems": 2,
      "maxItems": 2
    },
    "widthPoint": {
      "type": "object",
      "required": ["t", "width", "label"],
      "properties": {"t": {"type": "number", "minimum": 0, "maximum": 1}, "width": {"type": "number", "exclusiveMinimum": 0}, "label": {"type": "string"}},
      "additionalProperties": false
    },
    "terminal": {
      "type": "object",
      "required": ["label", "center", "radius"],
      "properties": {"label": {"type": "string", "minLength": 1}, "center": {"$ref": "#/$defs/point"}, "radius": {"type": "number", "exclusiveMinimum": 0}},
      "additionalProperties": false
    },
    "overlap": {
      "type": "object",
      "required": ["label", "point", "body_region", "occlusion_order"],
      "properties": {"label": {"type": "string", "minLength": 1}, "point": {"$ref": "#/$defs/point"}, "body_region": {"type": "string", "minLength": 1}, "occlusion_order": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    }
  }
}
