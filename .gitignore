# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# packaging / build
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# virtual envs
.venv/
venv/
env/
ENV/

# test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---------------------------------------------------------------------------
# Claude / Codex tooling
# ---------------------------------------------------------------------------
.claude/settings.local.json
.codex/
*.session.json

# ---------------------------------------------------------------------------
# dev/ — regeneratable release & verification artifacts
# Rebuilt by the release tooling; only the text reports/manifests are tracked.
# ---------------------------------------------------------------------------
dev/archives/*.zip
dev/release/*.whl
dev/release/*.zip
dev/evidence/*.zip
# Local skill-package scratch archives are reproducible from the source tree;
# canonical release archives belong under dev/release/ instead.
skills/*.zip
temp/
drawings/
dev/dogfood/s1s9/img2drawing_example_output/

# Local P1 iteration previews and regenerable frame sequences.
dev/p1_reference_run/ideal_overlay_preview.png
dev/p1_reference_run/run/timelapse/frames/

# P2 reference-run review rasters are regenerated from the checkpoint. Keep the
# pass-level drawings, while excluding repeated crop/overlay/difference boards.
dev/p2_reference_run/run/reviews/**/*.png
!dev/p2_reference_run/run/reviews/**/current_drawing.png
dev/p2_reference_run/run/timelapse/frames/

# P3 reference-run: commit only the reproducible source, resumable checkpoint,
# final trace/manifest, curated root boards and the final P3 review evidence.
# All predecessor/intermediate review packets and raster boards are regenerable.
dev/p3_reference_run/run/reviews/P1_gesture/
dev/p3_reference_run/run/reviews/P2_primary_axes/
dev/p3_reference_run/run/reviews/**/*.json
dev/p3_reference_run/run/reviews/**/*.md
dev/p3_reference_run/run/reviews/**/*.png
!dev/p3_reference_run/run/reviews/P3_primary_masses/pass_01/current_drawing.png
!dev/p3_reference_run/run/reviews/P3_primary_masses/pass_03/current_drawing.png
!dev/p3_reference_run/run/reviews/P3_primary_masses/pass_06/current_drawing.png
!dev/p3_reference_run/run/reviews/P3_primary_masses/pass_06/**/*.json
!dev/p3_reference_run/run/reviews/P3_primary_masses/pass_06/**/*.md
dev/p3_reference_run/run/reopen_archive/
dev/p3_reference_run/run/timelapse/
dev/p3_reference_run/run/compare/
dev/p3_reference_run/run/canonical_trace.json
dev/archives