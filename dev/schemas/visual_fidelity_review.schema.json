{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://img2drawing.local/schemas/visual_fidelity_review.schema.json",
  "title": "Visual fidelity review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "manifest_digest", "drawing_state_sha256", "drawing_artifact_sha256", "history_cursor", "observation_lock_digest", "evaluator_id", "decision", "findings", "rationale", "blind_packet_digest"],
  "properties": {
    "schema": {"const": "img2drawing.visual_fidelity_review.v1"},
    "stage": {"const": "P3_primary_masses"},
    "manifest_digest": {"$ref": "#/$defs/sha256"},
    "drawing_state_sha256": {"$ref": "#/$defs/sha256"},
    "drawing_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "history_cursor": {"type": "integer", "minimum": 0},
    "observation_lock_digest": {"$ref": "#/$defs/sha256"},
    "evaluator_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["revise", "advance"]},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string"},
    "blind_packet_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
