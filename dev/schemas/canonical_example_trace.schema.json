{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "img2drawing Canonical Example Trace v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "example",
    "stage",
    "initial_dominant_path_start",
    "initial_dominant_path_start_semantics",
    "pass1",
    "inter_pass_corrections",
    "pass2",
    "review_chain",
    "current_stage",
    "autonomy_note"
  ],
  "properties": {
    "schema": {
      "const": "img2drawing.canonical_example_trace.v1"
    },
    "initial_dominant_path_start_semantics": {
      "const": "line_of_action_head_end"
    },
    "pass1": {
      "type": "object",
      "required": [
        "decision",
        "remaining_concerns",
        "local_review_ids",
        "worker_packet"
      ],
      "properties": {
        "decision": {
          "const": "revise"
        }
      }
    },
    "pass2": {
      "type": "object",
      "required": [
        "memory_state",
        "parent_review_digest",
        "carried_concerns",
        "inter_pass_correction_action_ids",
        "decision",
        "remaining_concerns",
        "advance_rationale",
        "local_review_ids",
        "worker_packet"
      ],
      "properties": {
        "memory_state": {
          "const": "revision_continuation"
        },
        "decision": {
          "const": "advance"
        },
        "remaining_concerns": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "current_stage": {
      "const": "P2_primary_axes"
    }
  }
}