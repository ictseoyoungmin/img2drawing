{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://img2drawing.local/schemas/grammar_card_stroke_plan.schema.json",
  "title": "Grammar-card stroke-plan consumption metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "card_id",
    "card_digest",
    "stage",
    "polarity",
    "source_audit_status",
    "scope",
    "geometry_authority",
    "geometry_mutation",
    "transfer_tokens"
  ],
  "properties": {
    "schema": {"const": "img2drawing.grammar_card_stroke_plan.v1"},
    "card_id": {"type": "string", "minLength": 1},
    "card_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage": {"type": "string", "minLength": 1},
    "polarity": {"enum": ["positive", "negative"]},
    "source_audit_status": {"enum": ["pass", "fail", "unproven", "not_audited"]},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "geometry_authority": {"const": "frozen_subject_observation"},
    "geometry_mutation": {"const": "forbidden"},
    "transfer_tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token_id", "stage", "part", "role", "mapping", "scope", "polarity", "geometry_authority"],
        "properties": {
          "token_id": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "minLength": 1},
          "part": {"type": ["string", "null"]},
          "role": {"type": ["string", "null"]},
          "mapping": {"type": "string", "minLength": 1},
          "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "polarity": {"enum": ["positive", "negative"]},
          "geometry_authority": {"const": "frozen_subject_observation"}
        }
      }
    }
  }
}
