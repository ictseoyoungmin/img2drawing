{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://img2drawing.local/schemas/vnext_dogfood_evaluator.schema.json",
  "title": "img2drawing vNext independent evaluator brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "independent_review", "review_axes", "artifacts", "reopen_routing"],
  "properties": {
    "schema": {"const": "img2drawing.dogfood.evaluator_brief.v1"},
    "case_id": {"enum": ["D01", "D02", "D03", "D04", "D05-A", "D05-B", "D06"]},
    "independent_review": {"const": true},
    "review_axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sealed_input", "checkpoint", "final_png", "replay_manifest", "timelapse_gif"],
      "properties": {
        "sealed_input": {"type": "string", "pattern": "^evidence/[^/]+\\.json$"},
        "checkpoint": {"type": "string", "pattern": "^evidence/session/[^/]+\\.json$"},
        "final_png": {"type": "string", "pattern": "^evidence/output/[^/]+\\.png$"},
        "replay_manifest": {"type": "string", "pattern": "^evidence/output/[^/]+\\.json$"},
        "timelapse_gif": {"type": "string", "pattern": "^evidence/output/[^/]+\\.gif$"}
      }
    },
    "reopen_routing": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^B(0[1-9]|1[0-8])(-R1)?$"
      }
    }
  }
}
