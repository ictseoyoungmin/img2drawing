{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://img2drawing.local/schemas/lower_body.schema.json",
  "title": "Lower body evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pelvis_bounds", "pelvis_turn", "leg_a_profile", "leg_b_profile", "negative_space_profile", "support_leg", "counterbalance_direction", "source_surface", "observation_id", "source_artifact_sha256", "observation_lock_digest", "source_state_sha256", "uncertainty_notes"],
  "properties": {
    "schema": {"const": "img2drawing.lower_body.v1"},
    "pelvis_bounds": {"$ref": "#/$defs/bounds"},
    "pelvis_turn": {"enum": ["left", "right", "none", "unknown"]},
    "leg_a_profile": {"type": "object"},
    "leg_b_profile": {"type": "object"},
    "negative_space_profile": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "array",
        "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0}],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "support_leg": {"enum": ["leg_A", "leg_B", "unknown"]},
    "counterbalance_direction": {"enum": ["left", "right", "center", "unknown"]},
    "source_surface": {"enum": ["reference", "drawing"]},
    "observation_id": {"type": "string", "minLength": 1},
    "source_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "observation_lock_digest": {"$ref": "#/$defs/sha256"},
    "source_state_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "uncertainty_notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bounds": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "minItems": 4,
      "maxItems": 4
    }
  }
}
